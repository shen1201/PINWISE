# FinPilot 後端設定範例
# 請將需要的項目加入專案根目錄的 .env；不要把真實 .env 提交到 Git。
# AI 助手與完整研究只需先填 GEMINI_API_KEY；其餘來源已有免費預設值。

# ── 本機服務（皆有預設值） ──────────────────────────────────────────────
FINPILOT_HOST=127.0.0.1
FINPILOT_PORT=8080
# 部署平台若只提供 PORT，程式也會自動採用；FINPILOT_PORT 優先。
# PORT=8080
FINPILOT_LOG_LEVEL=info
FINPILOT_REQUEST_TIMEOUT_SECONDS=12
FINPILOT_RETRY_ATTEMPTS=2
FINPILOT_CACHE_TTL_SECONDS=300
FINPILOT_PUBLIC_DATA_STALE_HOURS=72

# ── Gemini（使用 AI 助手或研究時必填；公開資料 API 不需要） ──────────
# 在 Google AI Studio 建立。金鑰只由 Python 後端讀取，不會送到瀏覽器。
# 申請：https://aistudio.google.com/app/apikey
# 官方說明：https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
# 官方穩定模型；可依帳戶可用模型調整，不需修改程式碼。
GEMINI_MODEL=gemini-3.5-flash-lite
# 助手安全上限（皆有程式預設，一般不需修改）
FINPILOT_ASSISTANT_MAX_INPUT_CHARS=1200
FINPILOT_ASSISTANT_MAX_OUTPUT_TOKENS=1024
FINPILOT_ASSISTANT_MAX_HISTORY_MESSAGES=8
FINPILOT_ASSISTANT_MAX_TOOL_CALLS=3
FINPILOT_ASSISTANT_STREAM_TIMEOUT_SECONDS=90
FINPILOT_RESEARCH_MAX_OUTPUT_TOKENS=2048

# ── 線上預覽保護（本機預設皆關閉） ───────────────────────────────────
# Render 隔離預覽建議照 render.yaml 設為 true。fixture 模式不連線到外部資料或 Gemini。
FINPILOT_PREVIEW_FIXTURE_MODE=false
FINPILOT_GEMINI_ENABLED=true
# 啟用後，所有 /api、/docs、/openapi.json 都要求相同的 Bearer token；/healthz 僅回傳 ok。
FINPILOT_PREVIEW_AUTH_REQUIRED=false
# 請在 Render Secret 設至少 16 字元的隨機值，不要提交到 Git，也不要放進 Netlify bundle。
FINPILOT_PREVIEW_TOKEN=
# 僅列出允許的前端完整 origin，以逗號分隔；不可填 *。
# FINPILOT_CORS_ORIGINS=https://your-preview.netlify.app
FINPILOT_CORS_ORIGINS=
# 後端強制限制；即使前端被繞過仍會生效。
FINPILOT_RATE_LIMIT_PER_MINUTE=60
FINPILOT_ASSISTANT_MAX_CONCURRENT=2
FINPILOT_RESEARCH_MAX_CONCURRENT=1
FINPILOT_DAILY_GEMINI_CALL_LIMIT=20
FINPILOT_DAILY_GEMINI_TOKEN_LIMIT=250000
# Render 免費服務使用暫存目錄；若改付費磁碟，請設為掛載點（例如 /var/data）。
# FINPILOT_DATA_DIR=/tmp/finpilot-preview-data

# 後端啟動時在背景檢查一次全部資料來源（只讀 metadata，不消耗 Gemini 生成額度）。
# FINPILOT_STARTUP_SOURCE_CHECK=true

# ── PostgreSQL（選填） ───────────────────────────────────────────────
# 設定後，研究任務、Agent trace、Gemini 用量與使用者工作區（偏好、追蹤、候選、
# 比較、助手對話）改存 PostgreSQL；資料庫不存在時會自動建立，資料表啟動時自動建立。
# 未設定時沿用上方 FINPILOT_DATA_DIR 的 JSON 檔案，瀏覽器資料只存在 localStorage。
# 密碼含 @ : / # % 時須改寫為 %40 %3A %2F %23 %25。
# DATABASE_URL=postgresql://postgres:你的密碼@127.0.0.1:5432/finpilot

# ── 官方公開資料端點（已有免費預設值，一般不需修改） ──────────────────
TWSE_OPENAPI_BASE_URL=https://openapi.twse.com.tw/v1
TPEX_OPENAPI_BASE_URL=https://www.tpex.org.tw/openapi/v1
TWSE_NEWS_RSS_URL=https://www.twse.com.tw/rwd/zh/news/feed?type=rss

# ── FinMind（Token 選填） ──────────────────────────────────────────────
# 未填時使用官方匿名免費額度；填入後依帳戶方案提高配額。
# 申請／取得 Token：https://finmindtrade.com/
# 官方說明：https://finmind.github.io/quickstart/
FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4
FINMIND_TOKEN=

# ── Shioaji（選配，預設關閉） ─────────────────────────────────────────
# 啟用前另執行：.venv/bin/pip install -r backend/requirements-shioaji.txt
# 本專案只讀行情，不啟用憑證或下單功能。
# 官方說明：https://sinotrade.github.io/tutor/prepare/token/
# API Key 管理：https://www.sinotrade.com.tw/newweb/PythonAPIKey/
SHIOAJI_ENABLED=false
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_SIMULATION=true

# ── 測試保護（只應由測試程序的環境變數設定） ─────────────────────────
# 設為 true 時不載入專案 .env；一般啟動不要設定。
# FINPILOT_SKIP_DOTENV=false
